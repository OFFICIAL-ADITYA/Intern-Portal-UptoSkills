# Database and Server
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/intern_portal
JWT_SECRET=your_jwt_secret_key_here
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Brevo SMTP Configuration (Required for transactional notifications and reset links)
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=noreply@uptoskill.com

# Optional Resend Fallback
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=UPTOSKILL <onboarding@resend.dev>

# Initial Admin User Setup (used by scripts/createAdmin.js)
ADMIN_NAME=UptoSkills Admin
ADMIN_EMAIL=admin@uptoskills.com
ADMIN_PASSWORD=your_secure_admin_password

# Puppeteer Chromium Path (Optional, for container/VPS hosts lacking bundled Chromium)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Optional Chatbot Service Integration (Task M)
# CHATBOT_SERVICE_URL=https://chatbot.uptoskills.internal/api/chat
# CHATBOT_API_KEY=your_chatbot_service_token

# Cron Jobs Schedule Timezone: Asia/Kolkata (Hardened in code)
